# RPG Academy — шаблон переменных окружения.
# Локально: скопируй в .env и заполни. На Railway: Variables сервиса бэкенда (значения в ${{ }} Railway
# подставляет сам). Секреты сюда не пиши: файл лежит в публичном репозитории.

# ── Django ────────────────────────────────────────────────────────────────
# Секрет: python -c "import secrets; print(secrets.token_urlsafe(60))"  ·  Railway: ${{ secret(64) }}
DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_STRING
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=core.settings.local

# На Railway (production):
# DJANGO_SETTINGS_MODULE=core.settings.production   (уже задан в Dockerfile.backend)
# ALLOWED_HOSTS=<сервис>.up.railway.app   домен Railway и хост фронтенда добавляются сами
# CSRF_TRUSTED_ORIGINS=https://<сервис>.up.railway.app   для входа в /admin/

# ── База данных ───────────────────────────────────────────────────────────
# Railway: DATABASE_URL=${{ Postgres.DATABASE_URL }}  (тогда POSTGRES_* не нужны)
# DATABASE_URL=
POSTGRES_DB=rpgdb
POSTGRES_USER=rpguser
POSTGRES_PASSWORD=rpgpass
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Соединение с базой на запрос (0): так советует Django для ASGI и так дешевле по памяти Postgres.
# DB_CONN_MAX_AGE=0

# ── Кэш (лимиты запросов) ─────────────────────────────────────────────────
# Необязателен: без REDIS_URL кэш живёт в памяти единственного процесса (для Railway Hobby этого достаточно).
# Нужен, только если процессов или реплик несколько.
# REDIS_URL=redis://redis:6379/0

# ── Фронтенд и почта ──────────────────────────────────────────────────────
# Адрес фронтенда: ссылки в письмах, CORS и проверка WebSocket. Railway: https://<проект>.vercel.app
FRONTEND_URL=http://localhost:3000
# Несколько адресов фронтенда через запятую (по умолчанию берётся FRONTEND_URL):
# CORS_ALLOWED_ORIGINS=https://my-app.vercel.app

# Почта: dev — письма в консоль. Railway блокирует SMTP, поэтому на проде — Resend (HTTPS API).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# RESEND_API_KEY=
# DEFAULT_FROM_EMAIL=RPG Academy <noreply@my-domain.tld>

# Next.js (Vercel: Settings → Environment Variables, затем Redeploy — значение вшивается при сборке)
NEXT_PUBLIC_API_BASE=http://localhost:8000/api
# На проде: https://<сервис>.up.railway.app/api

# ── Роли ──────────────────────────────────────────────────────────────────
# Код преподавателя для пилота: даёт роль преподавателя (свои курсы и классы, без админки).
# Не задан = PILOT-2026. Он публичный (он в репозитории), поэтому на проде задай свой. off = код выключен.
TEACHER_INVITE_CODE=PILOT-2026
# Регистрация преподавателя совсем без кода (на проде по умолчанию 0). Включать только с реальной почтой.
# TEACHER_SELF_REGISTRATION=0
# TEACHER_REQUIRE_EMAIL=0

# Суперпользователь создаётся при старте, если его ещё нет. После первого входа удали пароль из переменных.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=

# ── Запуск кода учеников ──────────────────────────────────────────────────
# Внешняя песочница Judge0: код выполняется не на нашем сервере. 100 = Python 3.12.
RUNNER_JUDGE0_URL=https://ce.judge0.com
RUNNER_JUDGE0_LANGUAGE_ID=100
# Ключ RapidAPI для платного Judge0 (необязательно):
# RUNNER_JUDGE0_KEY=
# Запуск кода без Docker и Judge0 прямо на машине, без изоляции. ТОЛЬКО для разработки.
RUNNER_ALLOW_UNSAFE_FALLBACK=False

# ── ИИ-наставник ──────────────────────────────────────────────────────────
# Gemini (бесплатный ключ: https://aistudio.google.com/app/apikey). Пусто = наставник выключен.
GEMINI_API_KEY=

# ── Пилот и аналитика ─────────────────────────────────────────────────────
# Начало пилота (ISO с часовым поясом): отчёт пилота считает измерения преподавателей с этого момента.
# PILOT_STARTED_AT=2026-11-02T00:00:00+05:00
# Доля учеников (0-100) с баннером помощи после 3 неудач; остальные — контрольная группа. 100 = у всех.
HELP_OFFER_SHARE=100
# Срок хранения следа обучения (дни) и соль псевдонимов в экспорте (пусто = SECRET_KEY).
LEARNING_DATA_RETENTION_DAYS=730
ANALYTICS_EXPORT_SALT=
# Необязательная модель риска ухода (JSON из `python -m risk.train`, см. ml/README.md).
RISK_MODEL_PATH=

# ── Мониторинг и безопасность (production) ────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SECURE_HSTS_SECONDS=31536000
