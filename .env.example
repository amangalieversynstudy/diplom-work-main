# RPG Academy — шаблон переменных окружения.
# Скопируй: cp .env.example .env  и заполни своими значениями.

# Django
# Сгенерировать секрет: python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_STRING
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=core.settings.local

# На продакшене ставь:
# DEBUG=False
# DJANGO_SETTINGS_MODULE=core.settings.production
# ALLOWED_HOSTS=my-domain.tld,www.my-domain.tld
# CSRF_TRUSTED_ORIGINS=https://my-domain.tld,https://www.my-domain.tld

# База данных (PostgreSQL)
POSTGRES_DB=rpgdb
POSTGRES_USER=rpguser
POSTGRES_PASSWORD=rpgpass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (кэш и лимиты) + Channels
REDIS_URL=redis://redis:6379/0

# Email — для dev: console (письма в логах), для prod: smtp.gmail.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# На продакшене раскомментируй блок и заполни:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=app-password-16-симв
# DEFAULT_FROM_EMAIL=RPG Academy <your@gmail.com>

# URL фронтенда — используется в email-ссылках verify/reset
FRONTEND_URL=http://localhost:3000
# На проде: https://my-domain.tld

# Gemini AI key (бесплатно на https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Next.js frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000/api
# На проде: https://my-domain.tld/api

# ──────────────────────────────────────────────────────────────
# MONITORING (MID-01 — Sentry, опционально)
# ──────────────────────────────────────────────────────────────
# Если задан — backend и фронт автоматически шлют ошибки в Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
# Для фронта (если включаешь @sentry/nextjs):
# NEXT_PUBLIC_SENTRY_DSN=

# ──────────────────────────────────────────────────────────────
# SECURITY (production only — см. core/settings/production.py)
# ──────────────────────────────────────────────────────────────
SECURE_HSTS_SECONDS=31536000

# Код регистрации преподавателей. Пусто = самостоятельная регистрация
# преподавателей выключена (роль выдаётся в /admin/). На проде задай длинную
# случайную строку: python -c "import secrets; print(secrets.token_urlsafe(24))"
TEACHER_INVITE_CODE=

# Локальный запуск кода без Docker и Judge0. ТОЛЬКО для разработки: код
# выполняется на самой машине без изоляции. В production держи False.
RUNNER_ALLOW_UNSAFE_FALLBACK=False

# Аналитика обучения: срок хранения следа (запуски кода, события) в днях и секрет
# для псевдонимов пользователей в экспорте (пусто = используется SECRET_KEY).
LEARNING_DATA_RETENTION_DAYS=730
ANALYTICS_EXPORT_SALT=
# Необязательная модель риска ухода (JSON из `python -m risk.train`, см. ml/README.md).
# Пусто = список раннего предупреждения работает только по правилам.
RISK_MODEL_PATH=

# Доля учеников (0-100), которым показывается баннер помощи после 3 неудач. Остальные -
# контрольная группа пилота (см. docs/PILOT.md). 100 = баннер у всех, эксперимента нет.
HELP_OFFER_SHARE=100
