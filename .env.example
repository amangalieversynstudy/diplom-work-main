# ============================================================
# RPG Academy — Шаблон переменных окружения
# Скопируй этот файл: cp .env.example .env
# Заполни значения перед запуском
# ============================================================

# ─── Django Core ───────────────────────────────────────────
# Сгенерируй: python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_STRING

# True только для локальной разработки; False на продакшене!
DEBUG=True

# Через запятую, без пробелов: localhost,127.0.0.1 или yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── База данных ───────────────────────────────────────────
POSTGRES_DB=rpgdb
POSTGRES_USER=rpguser
POSTGRES_PASSWORD=rpgpass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── Redis / Celery ────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Email ─────────────────────────────────────────────────
# Для разработки: console (письма в логах Docker)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Для продакшена раскомментируй и заполни:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ─── Fronted URL (для ссылок в письмах) ────────────────────
# Локально:
FRONTEND_URL=http://localhost:3000
# На продакшене замени на:
# FRONTEND_URL=https://yourdomain.com

# ─── AI (Gemini) ───────────────────────────────────────────
# Получить на: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── CORS ──────────────────────────────────────────────────
# Локально — разрешаем все (True), на продакшене — только свой домен!
# CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ─── Next.js Frontend ──────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000/api

# ─── Django settings module ────────────────────────────────
DJANGO_SETTINGS_MODULE=core.settings.local
