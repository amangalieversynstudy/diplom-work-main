FROM node:18-alpine

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci --omit=dev

COPY frontend/ ./

# Принимаем NEXT_PUBLIC_API_BASE как build argument (Railway передаёт его при сборке)
ARG NEXT_PUBLIC_API_BASE
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE

RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "start"]
